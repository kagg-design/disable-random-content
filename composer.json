{
  "name": "kagg-design/disable-random-content",
  "description": "Disable WordPress random content redirects",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/php-compatibility": "^9.3.5",
    "phpcompatibility/phpcompatibility-wp": "^2.1.8",
    "phpunit/phpunit": "^9.6.35",
    "squizlabs/php_codesniffer": "^3.13.6",
    "wp-coding-standards/wpcs": "^3.4.1",
    "wp-phpunit/wp-phpunit": "^7.1.3",
    "yoast/phpunit-polyfills": "^4.0.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "phpcs": "phpcs --standard=phpcs.xml",
    "integration": "phpunit -c phpunit.integration.xml",
    "integration:multisite": "phpunit -c phpunit.multisite.xml",
    "test": [
      "@phpcs",
      "@integration",
      "@integration:multisite"
    ]
  }
}
